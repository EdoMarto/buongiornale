# Telegram bot (create one with @BotFather and add it as an admin of your channel)
TELEGRAM_BOT_TOKEN=
# Channel to post into, e.g. @BuonGiornale (or a numeric chat id)
TELEGRAM_CHANNEL=@BuonGiornale

# Feed list and selection
FEEDS_FILE=feeds.json
DIGEST_HOURS=24
MAX_PER_CATEGORY=6

# Local files (git-ignored)
DB_PATH=buongiornale.db
LOGO_PATH=docs/logo.png
